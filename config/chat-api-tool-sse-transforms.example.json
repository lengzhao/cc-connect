{
  "default": {
    "emit": "thinking",
    "suppress": false,
    "text": {
      "en": "Running {tool}...",
      "zh": "正在执行 {tool}...",
      "zh-TW": "正在執行 {tool}...",
      "ja": "{tool} を実行中...",
      "es": "Ejecutando {tool}..."
    }
  },
  "transforms": [
    {
      "tool": "Agent",
      "emit": "client_flow",
      "flow_type": "agent_call",
      "args_from": "$.message_id",
      "suppress": false,
      "text": {
        "en": "SubAgent: Running...",
        "zh": "子Agent: 正在执行...",
        "zh-TW": "子Agent: 正在執行...",
        "ja": "子Agent: 実行中...",
        "es": "SubAgent: Ejecutando..."
      }
    },
    {
      "tool": "CreateTask",
      "emit": "client_flow",
      "when": "tool_result",
      "flow_type": "task_generating",
      "args_from": "$.task_id",
      "suppress": false,
      "text": {
        "en": "Generating task...",
        "zh": "正在生成任务...",
        "zh-TW": "正在生成任務...",
        "ja": "タスクを生成中...",
        "es": "Generando tarea..."
      }
    },
    {
      "tool": "Bash",
      "emit": "thinking",
      "suppress": false,
      "text": {
        "en": "Running command...",
        "zh": "正在执行命令...",
        "zh-TW": "正在執行命令...",
        "ja": "コマンドを実行中...",
        "es": "Ejecutando comando..."
      }
    },
    {
      "tool": "mcp__ccconnect__cc_connect_ask_user",
      "emit": "thinking",
      "suppress": false,
      "text": {
        "en": "Please choose and confirm:",
        "zh": "需要你选择并确认:",
        "zh-TW": "需要你選擇並確認:",
        "ja": "選択して確認してください:",
        "es": "Elige y confirma:"
      }
    },
    {
      "tool": "cc_connect_ask_user",
      "emit": "thinking",
      "suppress": false,
      "text": {
        "en": "Please choose and confirm:",
        "zh": "需要你选择并确认:",
        "zh-TW": "需要你選擇並確認:",
        "ja": "選択して確認してください:",
        "es": "Elige y confirma:"
      }
    },
    {
      "tool": "AskUserQuestion",
      "emit": "thinking",
      "suppress": false,
      "text": {
        "en": "Please choose and confirm:",
        "zh": "需要你选择并确认:",
        "zh-TW": "需要你選擇並確認:",
        "ja": "選択して確認してください:",
        "es": "Elige y confirma:"
      }
    }
  ]
}
